{
  "name": "proyecto-dentista-renato",
  "version": "1.0.0",
  "description": "Aplicacion web local para gestionar una consulta dental en un solo computador.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File ./scripts/open-app.ps1",
    "start:backend": "powershell -ExecutionPolicy Bypass -File ./scripts/start-backend.ps1",
    "shortcut": "powershell -ExecutionPolicy Bypass -File ./scripts/install-desktop-shortcut.ps1",
    "seed:demo": "powershell -ExecutionPolicy Bypass -File ./scripts/seed-demo.ps1",
    "test": "playwright test",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:report": "playwright show-report",
    "test:backend": "powershell -ExecutionPolicy Bypass -File ./scripts/test-backend.ps1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PelaoKratos/Proyecto-Dentista-Renato.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/PelaoKratos/Proyecto-Dentista-Renato/issues"
  },
  "homepage": "https://github.com/PelaoKratos/Proyecto-Dentista-Renato#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
